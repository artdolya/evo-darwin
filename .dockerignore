# Every image is built from the repository root: deploy/docker/Dockerfile, and the
# Dockerfiles that src/Docker/docker-compose.yml names.
# Only global.json, Directory.*.props and src/ are needed in the build context.
**/bin/
**/obj/
# A link to a checkout outside the build context. An image that needs the Krapka sources
# gets them as a second build context: see src/Docker/docker-compose.yml.
src/Krapka
.git/
.github/
.idea/
.vs/
.vscode/
deploy/
docs/
scripts/
tests/
**/*.md
